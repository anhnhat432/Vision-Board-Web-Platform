    "jsdom": "^28.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.2",
    "vite": "6.4.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lodash": "4.18.1",
    "protobufjs": "7.5.8",
    "vite": "6.4.2"
  }
