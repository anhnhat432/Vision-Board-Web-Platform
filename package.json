{
  "name": "vision-board-web-platform",
  "description": "A full-stack web app for turning life vision into SMART goals and 12-week execution plans.",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest --config vitest.fast.config.ts",
    "test:run": "vitest run --config vitest.fast.config.ts",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:unit": "vitest run --config vitest.fast.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:flows": "vitest run --config vitest.flows.config.ts",
    "test:sync": "vitest run --config vitest.sync.config.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:all": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:all && npm run build",
    "check:backend": "npm --prefix backend run check",
    "check:all": "npm run check && npm run check:backend",
    "env:check": "node scripts/check-runtime-env.mjs",
    "env:check:full": "node scripts/check-runtime-env.mjs --full-stack",
    "env:check:casso": "node scripts/check-runtime-env.mjs --full-stack --mode production --casso-billing",
    "backup:mongo": "node scripts/backup-mongodb.mjs",
    "backup:mongo:dry-run": "node scripts/backup-mongodb.mjs --dry-run",
    "visual:prod": "node scripts/visual-core-flow-qa.mjs",
    "qa:visual-ux-ui": "node scripts/visual-ux-ui-qa.mjs",
    "smoke:mvp1": "node scripts/smoke-mvp1-local-demo.mjs",
    "smoke:core-quality": "node scripts/smoke-core-quality.mjs",
    "smoke:prod:quick": "node scripts/smoke-production-quick.mjs",
    "smoke:prod": "node scripts/smoke-production-e2e.mjs",
    "smoke:launch": "node scripts/launch-smoke-test.mjs",
    "smoke:mvp2-sync": "node scripts/smoke-mvp2-sync-staging.mjs",
    "smoke:mvp2-sync:staging": "node scripts/smoke-mvp2-sync-staging.mjs",
    "test:e2e:lww": "playwright test e2e/sync-lww.spec.ts"
  },
