exports[`PrimaryActionCard > renders the default hero shell with tokenized card spacing 1`] = `
<div
  class="glass-surface text-card-foreground flex flex-col rounded-[var(--r-card)] border-2 bg-white/94 shadow-sm border-primary gap-[var(--space-stack)] p-[var(--space-loose)] hero-surface"
  data-card-hovering="false"
  data-slot="card"
  style="--card-pointer-x: 0.5; --card-pointer-y: 0.5; --card-rotate-x: 0deg; --card-rotate-y: 0deg; --card-shift-x: 0px; --card-shift-y: 0px;"
>
  <div
    class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2.5 has-data-[slot=card-action]:grid-cols-[1fr_auto] sm:px-7 sm:pt-7 [.border-b]:pb-5 sm:[.border-b]:pb-7 p-0"
    data-slot="card-header"
  >
    <h3
      class="leading-tight tracking-normal"
      data-slot="card-title"
    >
      Việc quan trọng nhất
    </h3>
    <p
      class="text-muted-foreground text-sm leading-6 tracking-normal"
      data-slot="card-description"
