{
  "name": "vision-board-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm run build",
    "reconcile:entitlements": "npx ts-node scripts/reconcile-entitlements.ts"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@vision-board/shared-types": "file:../shared-types",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.9.5",
    "vision-board-web-platform": "file:.."
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
