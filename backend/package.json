{
  "name": "vision-board-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node dist/scripts/runNodeTests.js",
    "test:run": "npm run build && node dist/scripts/runNodeTests.js",
    "check": "npm run typecheck && npm run build",
    "check:env": "npm run build && node dist/scripts/checkProductionEnv.js",
    "cleanup:tombstones": "npm run build && node dist/scripts/cleanupTombstones.js",
    "rebuild:soft-delete-indexes": "npm run build && node dist/scripts/rebuildSoftDeleteIndexes.js",
    "rebuild:sync-mutation-indexes": "npm run build && node dist/scripts/rebuildSyncMutationLogIndexes.js",
    "reconcile:entitlements": "npx ts-node scripts/reconcile-entitlements.ts"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@payos/node": "^2.0.5",
    "@sentry/node": "^10.52.0",
    "@vision-board/shared-types": "file:../shared-types",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "vision-board-web-platform": "file:.."
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "protobufjs": "7.6.4",
    "uuid": "^11.1.1"
  }
}
