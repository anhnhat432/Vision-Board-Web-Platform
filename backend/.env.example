PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vision_board
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FRONTEND_ORIGIN=http://localhost:5173

# Billing provider
# mock is local/test only. Implemented real providers: casso | payos.
# momo/vnpay are recognized placeholders, but production paid checkout rejects
# them until their adapters are implemented.
BILLING_PROVIDER=mock

# Paid checkout kill-switch (backend, defense-in-depth).
# Set to 1/true/yes/on to make POST /billing/checkout-session and
# POST /billing/public-checkout-session return 503 with errorCode
# "checkout_disabled" without invoking the payment provider adapter.
# Use this together with the frontend flag VITE_BILLING_PAID_CHECKOUT_DISABLED
# when the active payment provider is expired (e.g. Casso Standard) or the
# next adapter (e.g. PayOS) is not implemented yet. Independent of
# BILLING_PROVIDER so a stale provider config cannot leak unsafe checkout.
BILLING_PAID_DISABLED=0

# memory | mongo
# Use mongo for real paid billing so subscriptions and entitlements survive restarts.
BILLING_REPOSITORY=mongo

# Optional comma-separated Firebase account emails that should become admins on login.
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Casso + VietQR billing. Required when BILLING_PROVIDER=casso.
# For Casso Webhook V2, set the checksum key here.
CASSO_WEBHOOK_SECRET=
# Optional explicit names if you want to keep checksum and legacy secure token separate.
CASSO_WEBHOOK_CHECKSUM_KEY=
CASSO_CHECKSUM_KEY=
CASSO_SECURE_TOKEN=
CASSO_BANK_ACCOUNT=
CASSO_BANK_NAME=MB
CASSO_ACCOUNT_NAME=
PLUS_PRICE_VND=99000

# PayOS billing. Required when BILLING_PROVIDER=payos and paid checkout is enabled.
# Keep BILLING_PAID_DISABLED=1/true in production until PayOS staging E2E and ops sign-off pass.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional app-level defaults if caller does not pass return/cancel URLs.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Email notifications (optional; set EMAIL_PROVIDER=resend or smtp to send real email)
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
BILLING_SUPPORT_EMAIL=

# SMTP email provider (EMAIL_PROVIDER=smtp). Use TLS/STARTTLS for production support/refund emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Manual refund policy
REFUND_WINDOW_DAYS=7
REFUND_MAX_USED_PERCENT=25

# MongoDB backup script (optional)
MONGODB_BACKUP_DIR=backups/mongodb
MONGODB_BACKUP_RETENTION_DAYS=14
MONGODUMP_BIN=mongodump
GPG_BIN=gpg
MONGODB_BACKUP_GPG_PASSPHRASE=
MONGODB_BACKUP_R2_PREFIX=mongodb/vision-board
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
