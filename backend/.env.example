R2_ENDPOINT=
# Public base URL where R2 bucket objects are served (no trailing slash).
# Use a Cloudflare R2 public bucket URL or a custom domain bound to the bucket.
# Example: https://pub-xxxxxxxx.r2.dev or https://cdn.example.com
R2_PUBLIC_BASE_URL=

# AI Assistant
# Chọn provider: gemini | groq
ASSISTANT_PROVIDER=groq
# Groq (đăng ký tại console.groq.com bằng Google, lấy API key dạng gsk_xxx)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Gemini (recommended default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.1-flash-lite

# AI Assistant V2 (Phase 3)
# Tên API key/model chung. Production assistant hiện chạy trên Groq.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_SMART_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# AI Assistant G3 — Structured output (JSON mode) cho Groq.
# Khi bật (1/true), nhánh action/workflow của Groq gửi response_format: { type: "json_object" }
# để giảm invalid action block. Chat tự do vẫn dùng text thường.
# Default off để không thay đổi hành vi hiện tại.
AI_ENABLE_STRUCTURED_OUTPUT=0

# AI Assistant G4 — Telemetry tối thiểu (redacted) cho assistant.
# Khi bật (1/true), backend ghi turn-level metric (provider/model/route/latency/error/action/token estimate,
# session hash) và nhận event observability redacted từ frontend qua POST /api/ai/assistant/telemetry.
# KHÔNG lưu raw prompt/secret; chỉ field an toàn. Default off để không tạo overhead khi chưa cần.
AI_ENABLE_TELEMETRY=0

# AI Assistant GĐ5 — Kill-switch streaming cho Groq chat tự do.
# Default ON (1). Đặt =0 để ép buffered toàn bộ (tắt nhanh streaming khi incident), không cần đổi code.
AI_ENABLE_STREAMING=1

# AI Assistant GĐ5 — Rollout / A-B testing (chỉ áp dụng signed-in real-mode users).
# Phân bổ deterministic theo session hash (one-way). Demo mode hoặc thiếu identity -> control, không chặn.
# AI_CANARY_PERCENT: 0..100, phần trăm user vào nhóm bật tính năng mới. 100 = full rollout.
AI_CANARY_PERCENT=100
# AI_EXPERIMENT: tên experiment hiện tại để gắn vào telemetry (rỗng = không chạy A/B).
AI_EXPERIMENT=
# AI_EXPERIMENT_VARIANTS: danh sách variant cách nhau bằng dấu phẩy, vd "control,variant_a".
AI_EXPERIMENT_VARIANTS=control

# AI Assistant GĐ5 — Ngưỡng SLO cho alerting vận hành (đọc telemetry redacted).
# Vượt ngưỡng sẽ sinh alert ở GET /api/ai/assistant/alerts (admin-only).
AI_SLO_P95_LATENCY_MS=12000
AI_SLO_ERROR_RATE_PCT=3
AI_SLO_TIMEOUT_RATE_PCT=2
AI_SLO_RATE_LIMIT_RATE_PCT=5
AI_SLO_ACTION_FAIL_RATE_PCT=5
AI_SLO_AVG_TOKEN_BUDGET=4000
# Cost theo tiền tệ (USD). Đặt đơn giá ước tính USD / 1K token của provider để bật alert chi phí.
# AI_COST_PER_1K_TOKENS_USD=0 (chưa biết giá) => bỏ qua alert cost-USD, chỉ dùng token budget ở trên.
# AI_SLO_TOTAL_COST_USD=0 => tắt alert theo tiền; đặt > 0 để cảnh báo khi chi phí ước tính trong cửa sổ vượt ngưỡng.
AI_COST_PER_1K_TOKENS_USD=0
AI_SLO_TOTAL_COST_USD=0
# Cửa sổ thời gian (phút) cộng chi phí cost-USD. Mặc định 60 => ngưỡng là USD/giờ.
AI_SLO_COST_WINDOW_MINUTES=60
# Secret-leak alert (critical): số lần secret/token bị redaction (trong cửa sổ) tối đa chấp nhận.
# 0 = mọi lần phát hiện secret/token bị che đều cảnh báo ngay. Email lành tính KHÔNG tính.
AI_SLO_SECRET_LEAK_MAX=0
# Cửa sổ thời gian (phút) đếm secret-leak hit. Mặc định 60 => alert tự lành khi hit cũ trôi đi.
AI_SLO_SECRET_LEAK_WINDOW_MINUTES=60
# Số turn tối thiểu trước khi đánh giá SLO (tránh cảnh báo do mẫu nhỏ).
AI_SLO_MIN_SAMPLE=20
