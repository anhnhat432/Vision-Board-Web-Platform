MONGODB_BACKUP_R2_PREFIX=mongodb/vision-board
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Public base URL where R2 bucket objects are served (no trailing slash).
# Use a Cloudflare R2 public bucket URL or a custom domain bound to the bucket.
# Example: https://pub-xxxxxxxx.r2.dev or https://cdn.example.com
R2_PUBLIC_BASE_URL=

# AI Assistant
# Chọn provider: groq (mặc định, free, không cần thẻ) hoặc gemini (tier 1 trả phí)
ASSISTANT_PROVIDER=groq
# Groq (đăng ký tại console.groq.com bằng Google, lấy API key dạng gsk_xxx)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (chỉ dùng khi ASSISTANT_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI Assistant V2 (Phase 3)
# Tên API Key chung và Model chung để an toàn bảo mật ở backend
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
