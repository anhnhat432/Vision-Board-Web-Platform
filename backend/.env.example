PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vision_board
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FRONTEND_ORIGIN=http://localhost:5173

# Billing provider
# mock | casso | payos | momo | vnpay
BILLING_PROVIDER=mock

# memory | mongo
# Use mongo for real paid billing so subscriptions and entitlements survive restarts.
BILLING_REPOSITORY=mongo

# Optional comma-separated Firebase account emails that should become admins on login.
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Casso + VietQR billing. Required when BILLING_PROVIDER=casso.
# For Casso Webhook V2, set the checksum key here.
CASSO_WEBHOOK_SECRET=
# Optional explicit names if you want to keep checksum and legacy secure token separate.
CASSO_WEBHOOK_CHECKSUM_KEY=
CASSO_CHECKSUM_KEY=
CASSO_SECURE_TOKEN=
CASSO_BANK_ACCOUNT=
CASSO_BANK_NAME=MB
CASSO_ACCOUNT_NAME=
PLUS_PRICE_VND=99000

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Email notifications (optional; set EMAIL_PROVIDER=resend or smtp to send real email)
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
BILLING_SUPPORT_EMAIL=

# SMTP email provider (EMAIL_PROVIDER=smtp). Use TLS/STARTTLS for production support/refund emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Manual refund policy
REFUND_WINDOW_DAYS=7
REFUND_MAX_USED_PERCENT=25

# MongoDB backup script (optional)
MONGODB_BACKUP_DIR=backups/mongodb
MONGODB_BACKUP_RETENTION_DAYS=14
MONGODUMP_BIN=mongodump

# AI Assistant
# Chọn provider: groq (mặc định, free, không cần thẻ) hoặc gemini (tier 1 trả phí)
ASSISTANT_PROVIDER=groq
# Groq (đăng ký tại console.groq.com bằng Google, lấy API key dạng gsk_xxx)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (chỉ dùng khi ASSISTANT_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
