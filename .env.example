# Backend API
VITE_API_BASE_URL=http://localhost:4000/api

# Firebase client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App mode
# demo | real
# demo: local-first, no Firebase/backend required
# real: requires Firebase client config for login and authenticated backend sync
VITE_APP_MODE=demo

# MVP 2 guarded data mutation sync sender.
# Keep false for MVP 1 public demo.
VITE_ENABLE_12_WEEK_MUTATION_SYNC=false
VITE_ENABLE_12_WEEK_PULL_SYNC=false
VITE_ENABLE_12_WEEK_GOAL_TOMBSTONE_SYNC=true
VITE_ENABLE_12_WEEK_IMPORT_DRY_RUN=false
VITE_ENABLE_12_WEEK_CLOUD_IMPORT=false

# Billing debug details in Settings/Paywall
# true | false
VITE_SHOW_BILLING_DEBUG=false

# Sync/debug details in 12-week settings
# true | false
VITE_SHOW_SYNC_DEBUG=false

# AI Assistant feature flags (kill-switch). Default BẬT khi để trống.
# Đặt =0 (hoặc false/no/off) để TẮT nhanh lớp tốn chi phí/rủi ro mà không cần đổi code.
# Không phá demo mode hay assistant chat core; chỉ gate tính năng phụ trợ.
VITE_AI_ENABLE_MEMORY=1
VITE_AI_ENABLE_RETRIEVAL=1
VITE_AI_ENABLE_PROACTIVE_NUDGE=1

# Analytics
# off | ga4
VITE_ANALYTICS_MODE=off
VITE_GA_MEASUREMENT_ID=

# Error monitoring (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.02

# Optional outbox sync endpoint
VITE_OUTBOX_SYNC_ENDPOINT=

# Billing
# mock_provider | api_contract
VITE_BILLING_PROVIDER_MODE=mock_provider
VITE_BILLING_PROVIDER_LABEL=Mock provider
VITE_BILLING_SUPPORT_EMAIL=
VITE_REFUND_WINDOW_DAYS=7
VITE_REFUND_MAX_USED_PERCENT=25
VITE_BILLING_PLUS_MONTHLY_PRICE_VND=99000
VITE_BILLING_PLUS_PRICE_CYCLE_LABEL=tháng

# Paid checkout kill-switch (frontend).
# Set to 1/true/yes/on to disable paid checkout entry points app-wide:
# - UpgradePaywallDialog "Tiếp tục thanh toán" → disabled, shows support copy.
# - /billing/confirm submit blocked, shows "Thanh toán đang tạm khóa" banner.
# - /billing/plan upgrade/renew CTAs disabled, banner shown at top of page.
# Use this when the active payment provider is expired (e.g. Casso Standard) or
# the next provider adapter (e.g. PayOS) is not implemented yet, so real users
# cannot start a checkout that may fail to confirm.
# IMPORTANT: also set BILLING_PAID_DISABLED=1 in the backend env for defense in
# depth — the backend kill-switch protects users running a stale frontend bundle.
VITE_BILLING_PAID_CHECKOUT_DISABLED=0

# For real paid billing with the backend:
# VITE_APP_MODE=real
# VITE_BILLING_PROVIDER_MODE=api_contract
# VITE_BILLING_PROVIDER_LABEL=Casso + VietQR
# VITE_BILLING_SUPPORT_EMAIL=support@example.com
# VITE_ENABLE_12_WEEK_MUTATION_SYNC=true
# VITE_ENABLE_12_WEEK_PULL_SYNC=true
# VITE_ENABLE_12_WEEK_GOAL_TOMBSTONE_SYNC=true
# VITE_ENABLE_12_WEEK_IMPORT_DRY_RUN=true
# VITE_ENABLE_12_WEEK_CLOUD_IMPORT=true

# If you have a shared billing API base, the app will derive:
# - /checkout
# - /portal
# - /restore
# - /entitlements
VITE_BILLING_API_BASE=

# Optional explicit billing endpoints
VITE_BILLING_CHECKOUT_ENDPOINT=
VITE_BILLING_PORTAL_ENDPOINT=
VITE_BILLING_RESTORE_ENDPOINT=
VITE_BILLING_ENTITLEMENT_SYNC_ENDPOINT=
